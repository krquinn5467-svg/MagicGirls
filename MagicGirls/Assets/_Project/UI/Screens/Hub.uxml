<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Theme/Theme.uss?fileID=7433441132597879392&amp;guid=d6744d05c5b05ed4580c57a9155a6f2c&amp;type=3#Theme"/>
    <Style src="project://database/Assets/_Project/UI/Screens/Hub.uss?fileID=7433441132597879392&amp;guid=e83bd68895cb0424d8d3cdc6fc6590d8&amp;type=3#Hub"/>
    <ui:VisualElement name="hub-screen" class="screen" style="flex-shrink: 1; flex-grow: 1;">
        <ui:VisualElement class="hub-header">
            <ui:VisualElement class="header-title-row">
                <ui:Label text="Magical Girl Academy" class="header-text"/>
                <ui:VisualElement class="header-buttons">
                    <ui:Button text="Characters" name="btn-characters" class="btn btn-secondary header-btn"/>
                    <ui:Button text="Calendar" name="btn-calendar" class="btn btn-secondary header-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header-info-row">
                <ui:Label name="time-label" text="Month 1, Week 1, Monday" class="body-text"/>
                <ui:Label name="gold-label" text="Gold: 100" class="gold-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
            <ui:VisualElement class="hub-content" style="flex-shrink: 0; align-content: center; justify-content: space-evenly; align-self: center;">
                <ui:VisualElement class="right-panel" style="flex-shrink: 0; flex-grow: 0;">
                    <ui:Image style="width: 207px; height: 268px; background-color: rgb(121, 224, 189); background-image: url(&quot;project://database/Assets/_Project/Art/Characters/SteamMan_idle.png?fileID=3669090937425060167&amp;guid=daf57534c753644bda30940317cea841&amp;type=3#SteamMan_idle_0&quot;); -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="character-panel" class="panel character-panel-container">
                    <ui:Label text="Team Status" class="sub-header"/>
                    <ui:VisualElement name="character-list" class="character-list"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" class="advance-container" style="flex-shrink: 0; align-self: flex-end;">
                <ui:Button text="Schedule Day" name="btn-schedule-day" class="btn btn-primary execute-btn"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
