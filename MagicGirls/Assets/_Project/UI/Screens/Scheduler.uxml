<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Theme/Theme.uss?fileID=7433441132597879392&amp;guid=d6744d05c5b05ed4580c57a9155a6f2c&amp;type=3#Theme"/>
    <Style src="project://database/Assets/_Project/UI/Screens/Hub.uss?fileID=7433441132597879392&amp;guid=e83bd68895cb0424d8d3cdc6fc6590d8&amp;type=3#Hub"/>
    <ui:VisualElement name="scheduler-screen" class="screen" style="flex-shrink: 1; flex-grow: 1;">
        <ui:VisualElement class="hub-header">
            <ui:VisualElement class="header-title-row">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                    <ui:Button text="Back" name="btn-back" class="btn btn-secondary header-btn" style="margin-right: 10px; margin-left: 2px;"/>
                    <ui:Label text="Scheduler" class="header-text" style="margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="header-buttons">
                    <ui:Button text="Calendar" name="btn-calendar" class="btn btn-secondary header-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header-info-row">
                <ui:Label name="time-label" text="Month 1, Week 1, Monday" class="body-text"/>
                <ui:Label name="gold-label" text="Gold: 100" class="gold-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
            <ui:VisualElement class="schedule-section panel" style="flex-shrink: 0;">
                <ui:Label text="Daily Schedule" class="sub-header"/>
                <ui:Label text="Click slots to cycle activities. Dungeon available at night only." class="dim-text" style="margin-bottom: 8px;"/>
                <ui:VisualElement name="schedule-header" class="schedule-header-row">
                    <ui:Label text="" class="schedule-name-col"/>
                    <ui:Label text="AM 1" class="schedule-col-header time-segment-morning"/>
                    <ui:Label text="AM 2" class="schedule-col-header time-segment-morning"/>
                    <ui:Label text="PM 1" class="schedule-col-header time-segment-day"/>
                    <ui:Label text="PM 2" class="schedule-col-header time-segment-day"/>
                    <ui:Label text="EVE" class="schedule-col-header time-segment-night"/>
                    <ui:Label text="NIGHT" class="schedule-col-header time-segment-night"/>
                </ui:VisualElement>
                <ui:VisualElement name="schedule-grid"/>
            </ui:VisualElement>
            <ui:VisualElement class="hub-content" style="flex-shrink: 0;">
                <ui:VisualElement class="right-panel" style="flex-shrink: 0;">
                    <ui:VisualElement name="VisualElement" class="panel legend-panel">
                        <ui:Label text="Activity Legend" class="sub-header"/>
                        <ui:VisualElement name="VisualElement" class="legend-grid" style="flex-direction: row; justify-content: space-evenly; flex-wrap: wrap;">
                            <ui:VisualElement class="legend-item" style="flex-shrink: 0;">
                                <ui:VisualElement class="legend-color slot-rest" style="flex-shrink: 0;"/>
                                <ui:Label text="Rest - Recover stamina" class="dim-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="legend-item" style="flex-shrink: 0;">
                                <ui:VisualElement class="legend-color slot-train" style="flex-shrink: 0;"/>
                                <ui:Label text="Train - STR/DEX/CON" class="dim-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="legend-item" style="flex-shrink: 0;">
                                <ui:VisualElement class="legend-color slot-school"/>
                                <ui:Label text="School - INT/WIS/Magic" class="dim-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="legend-item" style="flex-shrink: 0;">
                                <ui:VisualElement class="legend-color slot-dungeoncrawl"/>
                                <ui:Label text="Dungeon - XP/Loot (Night)" class="dim-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="legend-item" style="flex-shrink: 0;">
                                <ui:VisualElement class="legend-color slot-recreation"/>
                                <ui:Label text="Fun - Morale/CHA" class="dim-text"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="legend-item">
                                <ui:VisualElement class="legend-color slot-work"/>
                                <ui:Label text="Work - Gold" class="dim-text"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="advance-container" style="flex-shrink: 0;">
                        <ui:Button text="Execute Day" name="btn-execute-day" class="btn btn-primary execute-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
